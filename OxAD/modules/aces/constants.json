  "sensitive_templates": {
    "AdminSDHolder": {
      "dn": "CN=AdminSDHolder,CN=System,{base_dn}",
      "description": "SDProp copies this template's ACLs onto privileged objects every hour. Any principal with write access here can build a persistent domain-wide backdoor."
    },
    "DomainRoot": {
      "dn": "{base_dn}",
      "description": "The domain root's ACL. Rights such as DCSync, GenericAll, and WriteDACL can lead to full domain compromise."
    },
    "Domain Policy": {
      "dn": "CN=Policies,CN=System,{base_dn}",
      "description": "The Group Policy Container. Control over GPOs grants broad reach across the domain."
    },
    "AdminUsers Container": {
      "dn": "CN=Users,{base_dn}",
      "description": "The default Users container. Most privileged accounts live here."
    },
    "Domain Controllers OU": {
      "dn": "OU=Domain Controllers,{base_dn}",
      "description": "Domain controllers reside in this OU. Write access here can alter DC configuration."
    },
    "Schema": {
      "dn": "CN=Schema,CN=Configuration,{base_dn}",
      "description": "The AD schema. Schema changes affect the entire forest."
    },
    "Configuration": {
      "dn": "CN=Configuration,{base_dn}",
      "description": "The Configuration partition. Sites, Services, and Subnets live here."
    },
    "RID Manager": {
      "dn": "CN=RID Manager$,CN=System,{base_dn}",
      "description": "Manages the RID pool. Manipulation can lead to SID forgery."
    },
    "Infrastructure": {
      "dn": "CN=Infrastructure,{base_dn}",
      "description": "The Infrastructure Master role. Critical for cross-domain reference integrity."
    },
    "Password Policy": {
      "dn": "CN=Password Settings Container,CN=System,{base_dn}",
      "description": "The Fine-Grained Password Policy (PSO) container. Changes here can enforce a weak password policy."
    },
    "Deleted Objects": {
      "dn": "CN=Deleted Objects,{base_dn}",
      "description": "The deleted-objects container. Rights here are needed for tombstone reanimation."
    },
    "Domain DNS Zones": {
      "dn": "DC=DomainDnsZones,{base_dn}",
      "description": "The AD-integrated DNS zone. Write access to DNS records can enable MITM attacks."
    },
    "Forest DNS Zones": {
      "dn": "DC=ForestDnsZones,{base_dn}",
      "description": "The forest-wide DNS zone. Poses a forest-wide MITM risk."
    },
    "System Container": {
      "dn": "CN=System,{base_dn}",
      "description": "The parent object of AdminSDHolder, RID Manager, Password Settings, and Domain Policy. A principal with WriteDACL/GenericAll here can indirectly manipulate all child containers."
    }
  },
  "deep_scan": {
    "bases": [
      "{base_dn}",
      "CN=Configuration,{base_dn}",
